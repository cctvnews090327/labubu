        Size = UDim2.fromScale(1, 1),
    })
    create("UICorner", shell, { CornerRadius = UDim.new(0, 6) })
    create("UIStroke", shell, {
        Color = Color3.fromRGB(255, 68, 88),
        Thickness = 1,
        Transparency = 0.18,
    })

    local healthText = create("TextLabel", shell, {
        Name = "HealthText",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(6, 2),
        Size = UDim2.new(1, -12, 0, 21),
        Font = Enum.Font.GothamSemibold,
        TextColor3 = Color3.fromRGB(247, 249, 255),
        TextSize = 12,
        TextStrokeTransparency = 0.72,
        TextTruncate = Enum.TextTruncate.AtEnd,
    })

    local barBack = create("Frame", shell, {
        Name = "BarBack",
        BackgroundColor3 = Color3.fromRGB(54, 60, 73),
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(7, 27),
        Size = UDim2.new(1, -14, 0, 5),
    })
    create("UICorner", barBack, { CornerRadius = UDim.new(1, 0) })
    local healthFill = create("Frame", barBack, {
        Name = "Fill",
        BackgroundColor3 = Color3.fromRGB(65, 210, 120),
        BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1),
    })
    create("UICorner", healthFill, { CornerRadius = UDim.new(1, 0) })

    local function updateHealth()
        if not state.alive or not humanoid.Parent then
            return
        end
        local maximum = math.max(humanoid.MaxHealth, 1)
        local current = math.clamp(humanoid.Health, 0, maximum)
        local ratio = current / maximum
        healthText.Text = string.format(
            "%s  —  %d/%d HP",
            otherPlayer.DisplayName,
            math.ceil(current),
            math.ceil(maximum)
        )
        healthFill.Size = UDim2.fromScale(ratio, 1)
        healthFill.BackgroundColor3 = Color3.fromRGB(
            math.floor(235 - 170 * ratio),
            math.floor(65 + 150 * ratio),
            82
        )
    end

    visual.billboard = billboard
    visual.healthChanged = humanoid.HealthChanged:Connect(updateHealth)
    visual.maxHealthChanged = humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(updateHealth)
    updateHealth()
end

local function reconcilePlayer(otherPlayer)
    if not state.alive then
        return
    end

    local character = otherPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local head = character and character:FindFirstChild("Head")
    if not isEnemy(otherPlayer) or not character or not humanoid or not head or humanoid.Health <= 0 then
        clearPlayer(otherPlayer)
        return
    end

    local visual = state.visuals[otherPlayer]
    if visual and visual.character ~= character then
        clearPlayer(otherPlayer)
        visual = nil
    end
    if not visual then
        visual = { character = character }
        state.visuals[otherPlayer] = visual
    end

    if state.highlightsOn then
        if not visual.highlight or not visual.highlight.Parent then
            visual.highlight = makeHighlight(character)
        end
    else
        destroy(visual.highlight)
        visual.highlight = nil
    end

    if state.healthOn then
        if not visual.billboard or not visual.billboard.Parent then
            disconnect(visual.healthChanged)
            disconnect(visual.maxHealthChanged)
            visual.healthChanged = nil
            visual.maxHealthChanged = nil
            makeHealthDisplay(otherPlayer, character, humanoid, head, visual)
        end
    else
        disconnect(visual.healthChanged)
        disconnect(visual.maxHealthChanged)
        visual.healthChanged = nil
        visual.maxHealthChanged = nil
        destroy(visual.billboard)
        visual.billboard = nil
    end

    if not state.highlightsOn and not state.healthOn then
        state.visuals[otherPlayer] = nil
    end
end

local function reconcileAll()
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        reconcilePlayer(otherPlayer)
    end
end

local function unwatchPlayer(otherPlayer)
    local connections = state.watchers[otherPlayer]
    if connections then
        for _, connection in ipairs(connections) do
            disconnect(connection)
        end
        state.watchers[otherPlayer] = nil
    end
    clearPlayer(otherPlayer)
end

local function watchPlayer(otherPlayer)
    unwatchPlayer(otherPlayer)
    local connections = {}
    state.watchers[otherPlayer] = connections

    table.insert(connections, otherPlayer.CharacterAdded:Connect(function()
        task.defer(function()
            if state.alive then
                reconcilePlayer(otherPlayer)
            end
        end)
    end))
    table.insert(connections, otherPlayer.CharacterRemoving:Connect(function()
        clearPlayer(otherPlayer)
    end))
    table.insert(connections, otherPlayer:GetPropertyChangedSignal("Team"):Connect(function()
        if otherPlayer == localPlayer then
            reconcileAll()
        else
            reconcilePlayer(otherPlayer)
        end
    end))

    reconcilePlayer(otherPlayer)
end

