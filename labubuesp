local function paintToggle(statusLabel, enabled)
    statusLabel.Text = enabled and "ON" or "OFF"
    statusLabel.BackgroundColor3 = enabled
        and Color3.fromRGB(38, 181, 111)
        or Color3.fromRGB(100, 112, 135)
end

