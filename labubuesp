local state = {
    alive = true,
    highlightsOn = false,
    healthOn = false,
    connections = {},
    watchers = {},
    visuals = {},
}
environment.BloxstrikeEnemyVision = state

local function create(className, parent, properties)
    local instance = Instance.new(className)
    for property, value in pairs(properties or {}) do
        instance[property] = value
    end
    instance.Parent = parent
    return instance
end

local function track(connection)
    table.insert(state.connections, connection)
    return connection
end

local function disconnect(connection)
    if connection then
        pcall(function()
            connection:Disconnect()
        end)
    end
end

local function destroy(instance)
    if instance then
        pcall(function()
            instance:Destroy()
        end)
    end
end

local function isEnemy(otherPlayer)
    if otherPlayer == localPlayer then
        return false
    end
    if localPlayer.Team == nil or otherPlayer.Team == nil then
        return false
    end
    return otherPlayer.Team ~= localPlayer.Team
end

local function clearPlayer(otherPlayer)
    local visual = state.visuals[otherPlayer]
    if not visual then
        return
    end

    disconnect(visual.healthChanged)
    disconnect(visual.maxHealthChanged)
    destroy(visual.highlight)
    destroy(visual.billboard)
    state.visuals[otherPlayer] = nil
end

